From: Popcorn <popcorn@thepopcorn.fr>
Subject: [PATCH] ao_coreaudio: ne pas laisser de listener hotplug orphelin sur echec d'init

Retroportage de mpv af067b5ea8 (cleanup ao on init failure) et c5d391adba
(register hotplug after successful audiounit init), absents de v0.40.0 et
v0.41.0. En v0.40.0, un echec de ca_init_chmap/init_audiounit apres
register_hotplug_cb laissait le callback enregistre sur un ao libere :
crash (use-after-free) dans hotplug_cb au changement d'appareil audio
suivant (AirPods, Bluetooth).

Ajout local : remise a NULL de p->audio_unit apres dispose dans le chemin
d'erreur d'init_audiounit, sinon le nouvel uninit() sur echec dispose deux
fois la meme instance (bug latent present aussi sur mpv master).

diff --git a/audio/out/ao_coreaudio.c b/audio/out/ao_coreaudio.c
index 0f5fff8..79d13e7 100644
--- a/audio/out/ao_coreaudio.c
+++ b/audio/out/ao_coreaudio.c
@@ -141,6 +141,7 @@ static void init_physical_format(struct ao *ao);
 static void reinit_latency(struct ao *ao);
 static bool register_hotplug_cb(struct ao *ao);
 static void unregister_hotplug_cb(struct ao *ao);
+static void uninit(struct ao *ao);
 
 static bool reinit_device(struct ao *ao) {
     struct priv *p = ao->priv;
@@ -167,9 +168,6 @@ static int init(struct ao *ao)
     if (!reinit_device(ao))
         goto coreaudio_error;
 
-    if (!register_hotplug_cb(ao))
-        goto coreaudio_error;
-
     if (p->change_physical_format)
         init_physical_format(ao);
 
@@ -187,6 +185,9 @@ static int init(struct ao *ao)
     if (!r)
         goto coreaudio_error;
 
+    if (!register_hotplug_cb(ao))
+        goto coreaudio_error;
+
     reinit_latency(ao);
     ao->device_buffer = av_rescale(p->hw_latency_ns, ao->samplerate, 1000000000) * 2;
 
@@ -196,6 +197,7 @@ static int init(struct ao *ao)
     return CONTROL_OK;
 
 coreaudio_error:
+    uninit(ao);
     return CONTROL_ERROR;
 }
 
@@ -348,6 +350,9 @@ coreaudio_error_audiounit:
     AudioUnitUninitialize(p->audio_unit);
 coreaudio_error_component:
     AudioComponentInstanceDispose(p->audio_unit);
+    // Popcorn: init() appelle desormais uninit() sur echec ; sans remise a
+    // NULL, uninit() disposerait une seconde fois l'unite deja liberee.
+    p->audio_unit = NULL;
 coreaudio_error:
     return false;
 }
@@ -437,14 +442,18 @@ static void uninit(struct ao *ao)
 {
     struct priv *p = ao->priv;
 
-    dispatch_sync(p->queue, ^{
-        cancel_and_release_idle_work(p);
-    });
-    dispatch_release(p->queue);
+    if (p->queue) {
+        dispatch_sync(p->queue, ^{
+            cancel_and_release_idle_work(p);
+        });
+        dispatch_release(p->queue);
+    }
 
-    AudioOutputUnitStop(p->audio_unit);
-    AudioUnitUninitialize(p->audio_unit);
-    AudioComponentInstanceDispose(p->audio_unit);
+    if (p->audio_unit) {
+        AudioOutputUnitStop(p->audio_unit);
+        AudioUnitUninitialize(p->audio_unit);
+        AudioComponentInstanceDispose(p->audio_unit);
+    }
 
     if (p->original_asbd.mFormatID) {
         OSStatus err = CA_SET(p->original_asbd_stream,
